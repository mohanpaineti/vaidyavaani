# Package-local copy of the names this agent reads. Values live in .env, which
# is gitignored, and never in a package file. `unmute compile` writes the same
# list into build/livekit/.env.example from the `secrets:` block in agent.yaml.

# SLNG credential — listen, speak and the Context Router all use this one key.
# The repo's root .env.example calls it both VOICEAI_API_KEY and SLNG_API_KEY;
# unmute reads SLNG_API_KEY.
SLNG_API_KEY=

# The reasoning model's key. `think` is bound DIRECTLY to OpenAI because the
# SLNG Context Router has no org config provisioned — see the long note on
# models.think in agent.yaml and docs/03-p0-findings.md §5. If the router is
# provisioned later, this same key becomes the upstream credential the router
# forwards, so the name does not change. ⚠ Nobody has confirmed the team has
# this key; without it the agent cannot think.
OPENAI_API_KEY=

# Clinic Console, reached from the local tool handlers over localhost.
CONSOLE_URL=http://127.0.0.1:8808
CONSOLE_TOKEN=change-me-local-dev-only

# Local LiveKit dev server, read by the generated worker.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── The metrics log the console's HUD reads ──────────────────────────────────
# Nothing is emitted to build/livekit/dev.log unless UNMUTE_DEV_METRICS is set
# to something other than "" or "0". The generated utils/dev_metrics.py is
# literally inert without it (metrics_enabled() gates every emit), so an unset
# variable means an EMPTY HUD WITH NO ERROR to explain it — on stage.
#
# `unmute dev` sets this itself and writes the log, so the demo path is covered.
# Any other way of starting the worker is NOT: the generated README's own
# `uv run python -m livekit.agents start agent.py`, and a hand-started
# `docker compose -f compose.dev.yaml up`, both leave it unset. compose.dev.yaml
# passes the name through from the host environment with no default, so set it
# in the shell that starts the worker.
#
# This file is the package's own record of the names it reads. It is NOT loaded
# by anything: scripts/lib-env.sh reads the REPO ROOT .env.example, and the
# generated worker reads build/livekit/.env. Set the value where you start the
# worker, not here.
UNMUTE_DEV_METRICS=1

# ⚠ ALSO NOT OURS TO SET, and it is the half that actually breaks:
# console/app/config.py defaults CONSOLE_DEV_LOG to <repo>/build/livekit/dev.log,
# but `unmute compile vaidyavaani-agent` writes the log one directory deeper, at
# <repo>/vaidyavaani-agent/build/livekit/dev.log. The console finds no file,
# silently falls back to console/tests/fixtures/dev.log.sample, and serves
# HAND-WRITTEN sample timings — and GET /api/cost does the same, so a ₹ figure
# described as "measured audio seconds" would be measured from a fixture.
# The fix is one environment variable, set wherever the console is started:
#   CONSOLE_DEV_LOG=<repo>/vaidyavaani-agent/build/livekit/dev.log
# console/ and scripts/ are other sessions' areas (docs/04 §0), so this package
# reports it rather than writing it. See README.md, "The audit".
