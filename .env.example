# VaidyaVaani — local dev environment.
# Copy to `.env` and fill in. `.env` is gitignored; never commit real values.
# Verified against a real `unmute compile --target livekit` in P0 —
# see docs/03-p0-findings.md for what was confirmed and what was not.

# ── SLNG credential (same value for both names). Never commit the real file. ──
# Set it with `voiceai login` (writes ~/.config/voiceai/config.json), or export
# it here for the generated LiveKit worker, which reads SLNG_API_KEY.
VOICEAI_API_KEY=
SLNG_API_KEY=

# ── Upstream LLM for the SLNG Context Router ─────────────────────────────────
# ⚠ P0 FINDING: the Context Router is a CACHE IN FRONT OF YOUR OWN MODEL, not a
# model provider. `unmute compile` lists OPENAI_API_KEY in required_env and the
# generated worker builds the LLM as
#   openai.LLM(client=<slng router client>, model=...)
# pointed at https://in.context-router.slng.ai/v1 — so a second, upstream
# credential is required. Without it the agent cannot think.
# The router's `upstream.provider` must be one of:
#   openai | openai-compat | azure | vertex | bedrock
OPENAI_API_KEY=

# ── Clinic Console ───────────────────────────────────────────────────────────
CONSOLE_URL=http://127.0.0.1:8808
CONSOLE_TOKEN=change-me-local-dev-only
NEXT_PUBLIC_CONSOLE_URL=http://127.0.0.1:8808

# CONSOLE_PUBLIC_URL is DELIBERATELY ABSENT and must stay absent.
# It is what the take-home QR encodes (console/app/config.py:23). A Cloudflare
# quick tunnel takes a NEW RANDOM HOSTNAME on every restart, so any value
# written here or in .env points at a tunnel that no longer exists — a dead QR
# that looks perfectly healthy until a judge's phone scans it. scripts/dev-all.sh
# reads the live hostname from the running tunnel and passes it to the console
# for that run only, and scripts/preflight.sh FAILS if it finds a stored value.
# For the same reason: never pre-generate the QR, never put the URL on a slide.

# ── Local LiveKit dev server ─────────────────────────────────────────────────
# Verified in P0: `livekit-server --dev` binds 127.0.0.1:7880 and uses exactly
# these placeholder credentials. A token minted with them is accepted by
# /rtc/validate (HTTP 200 "success"). DEV ONLY — never off localhost.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# ── unmute dev metrics ───────────────────────────────────────────────────────
# Without this the generated worker emits NO dev.log records at all —
# metrics_enabled() returns false unless it is set to something other than ""
# or "0" (docs/03 §14). The metrics HUD is then silently empty with nothing to
# explain why, and no latency number can ever be measured. Export it in the
# shell that starts the generated LiveKit worker, not just here.
UNMUTE_DEV_METRICS=1

# ── Next.js dev server ───────────────────────────────────────────────────────
# The HTTPS tunnel (scripts/dev-tunnel.sh) fronts THIS port only. The console
# stays on 127.0.0.1 and is never tunnelled (docs/04 §1).
WEB_PORT=3000
